---
import ThemeSwitcher from './ThemeSwitcher.astro';
import AuthModal from './AuthModal.astro';
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand" aria-label="Wattouna home" style="text-decoration:none">
      <span class="brand-mark">⚡</span>
      <span>واطُنا <span style="color:var(--amber)">Wattouna</span><small>OPEN CLEAN ENERGY • طاقة مفتوحة</small></span>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Primary">
      <a href="/">الرئيسية (الرؤية)</a>
      <a href="/community">المشاريع</a>
      <a href="/workbench">المختبر التفاعلي</a>
      <a href="/profile">ملفي الشخصي</a>
    </nav>
    <div class="nav-cta">
      <span id="netPill" class="pill green" title="حالة الاتصال">🌐 متصل</span>
      <button id="workshopBtn" class="ws-btn" title="وضع الورشة دون اتصال: حفظ محلي فقط">🧰 ورشة</button>
      <ThemeSwitcher />
      <span id="authArea" class="auth-area"><span class="pill">…</span></span>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">☰</button>
    </div>
  </div>
</header>

<!-- Auth modal (extracted component: OAuth + guest mode) -->
<AuthModal />

<script type="module" define:vars={{ SUPA_URL, SUPA_ANON }}>
  import { createClient } from '/vendor/supabase.js';

  const isSupabaseConfigured = Boolean(SUPA_URL && SUPA_ANON);
  let supabase = null;
  try {
    if (isSupabaseConfigured) supabase = createClient(SUPA_URL, SUPA_ANON);
  } catch (e) { supabase = null; }

  const t = document.getElementById('menuToggle');
  const l = document.getElementById('navLinks');
  t?.addEventListener('click', () => l?.classList.toggle('open'));
  l?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => l.classList.remove('open')));

  const area = document.getElementById('authArea');

  function esc(s) { return String(s ?? '').replace(/</g, '&lt;'); }
  function isGuest() {
    try { return localStorage.getItem('wattouna-guest') === '1'; } catch (e) { return false; }
  }
  function openAuth() { window.dispatchEvent(new CustomEvent('wattouna:open-auth')); }

  function renderLoggedOut(demo) {
    area.innerHTML =
      (demo ? '<span class="pill" title="Supabase غير مربوط">☁️ محلي</span>' : '') +
      (isGuest() ? '<span class="pill green">🚶 زائر</span>' : '') +
      '<button id="loginBtn" class="btn btn-amber" style="padding:.5rem 1rem">تسجيل الدخول</button>';
    document.getElementById('loginBtn')?.addEventListener('click', openAuth);
  }

  function renderUser(user, profile) {
    const name = profile?.username || profile?.display_name || user.email?.split('@')[0] || 'صانع';
    const avatar = profile?.avatar_url || user.user_metadata?.avatar_url;
    area.innerHTML =
      '<div class="auth-user">' +
        (avatar ? `<img src="${esc(avatar)}" alt="" />` : '<span class="auth-ph">⚡</span>') +
        `<b>${esc(name)}</b>` +
        '<button id="userMenuBtn" aria-label="القائمة">▾</button>' +
        '<div id="userMenu" class="auth-menu" hidden>' +
          '<a href="/profile">👤 ملفي الشخصي</a>' +
          '<a href="/profile#my">⚡ مشاريعي</a>' +
          '<button id="logoutBtn">🚪 تسجيل الخروج</button>' +
        '</div>' +
      '</div>';
    const menu = document.getElementById('userMenu');
    document.getElementById('userMenuBtn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.hidden = !menu.hidden;
    });
    document.addEventListener('click', () => { if (menu) menu.hidden = true; });
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try { await supabase?.auth.signOut(); } catch (e) {}
      location.reload();
    });
  }

  (async function init() {
    if (!isSupabaseConfigured || !supabase) {
      renderLoggedOut(true);
      return;
    }
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { renderLoggedOut(false); return; }
      let profile = null;
      try {
        const r = await supabase.from('profiles').select('*').eq('id', session.user.id).single();
        profile = r.data || null;
      } catch (e) {}
      renderUser(session.user, profile);
      window.dispatchEvent(new CustomEvent('wattouna:auth', { detail: { user: session.user, profile } }));
    } catch (e) {
      renderLoggedOut(false);
    }
    supabase.auth.onAuthStateChange((_ev, session) => {
      window.dispatchEvent(new CustomEvent('wattouna:auth', { detail: { user: session?.user || null } }));
    });
  })();
</script>

<script>
(function () {
  var pill = document.getElementById('netPill');
  var btn = document.getElementById('workshopBtn');
  if (!pill || !btn) return;
  function workshop() {
    try { return localStorage.getItem('wattouna-offline') === '1'; } catch (e) { return false; }
  }
  function paint() {
    var off = !navigator.onLine, ws = workshop();
    pill.textContent = off ? '📴 دون اتصال' : ws ? '🧰 ورشة (محلي)' : '🌐 متصل';
    pill.className = 'pill ' + (off || ws ? 'amber' : 'green');
    btn.classList.toggle('on', ws);
  }
  btn.addEventListener('click', function () {
    try {
      localStorage.setItem('wattouna-offline', workshop() ? '0' : '1');
    } catch (e) {}
    paint();
  });
  window.addEventListener('online', paint);
  window.addEventListener('offline', paint);
  paint();
})();
</script>

<style>
  .auth-area { display: flex; align-items: center; gap: .5rem; }
  .ws-btn {
    background: var(--card); border: 1px solid var(--border); color: var(--text);
    border-radius: 999px; padding: .45rem .8rem; cursor: pointer;
    font-family: inherit; font-size: .82rem;
  }
  .ws-btn.on { border-color: var(--amber); box-shadow: 0 0 10px rgba(245,158,11,.35); }
  .auth-user { display: flex; align-items: center; gap: .5rem; position: relative; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: .25rem .6rem .25rem .3rem; }
  .auth-user img { width: 28px; height: 28px; border-radius: 50%; }
  .auth-ph { width: 28px; height: 28px; display: grid; place-items: center; background: var(--surface2); border-radius: 50%; }
  .auth-user b { font-size: .82rem; max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .auth-user button { background: transparent; border: none; color: var(--text); cursor: pointer; }
  .auth-menu { position: absolute; top: 110%; inset-inline-end: 0; background: var(--card); border: 1px solid var(--border); border-radius: 12px; min-width: 170px; display: grid; padding: .4rem; z-index: 60; }
  .auth-menu[hidden] { display: none; }
  .auth-menu a, .auth-menu button { padding: .5rem .7rem; border-radius: 8px; font-size: .85rem; color: var(--text); background: transparent; border: none; text-align: right; cursor: pointer; font-family: inherit; }
  .auth-menu a:hover, .auth-menu button:hover { background: var(--surface2); text-decoration: none; }
</style>
