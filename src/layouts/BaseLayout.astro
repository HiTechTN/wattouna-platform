---
// 🚀 Native BaseLayout
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title = "واطنا | منصة الطاقة النظيفة", description = "منصة تفاعلية لبناء الدوائر" } = Astro.props;
---
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      /* 🚀 NASA THEME GLOBALLY APPLIED */
      html, body {
        background-color: #020617 !important;
        background-image: 
          linear-gradient(rgba(6, 182, 212, 0.15) 1px, transparent 1px),
          linear-gradient(90deg, rgba(6, 182, 212, 0.15) 1px, transparent 1px) !important;
        background-size: 40px 40px !important;
        background-position: center top !important;
        color: #e2e8f0 !important;
        font-family: 'Inter', system-ui, sans-serif !important;
        margin: 0; min-height: 100vh; overflow-x: hidden;
      }
      .cyber-panel {
        background: rgba(15, 23, 42, 0.85) !important;
        backdrop-filter: blur(12px) !important;
        border: 1px solid rgba(6, 182, 212, 0.3) !important;
        border-radius: 12px !important;
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.2) !important;
      }
      /* إضاءة المكونات القديمة */
      .component-box, svg rect {
        fill: rgba(15, 23, 42, 0.95) !important;
        stroke: #06b6d4 !important;
        stroke-width: 2px !important;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5) !important;
      }
      svg path { filter: drop-shadow(0 0 3px #06b6d4) !important; stroke: #06b6d4 !important;}
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
