---
import BaseLayout from '../layouts/BaseLayout.astro';
import VoiceAI from '../components/VoiceAI.astro';
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<BaseLayout title="المختبر — لوحة دوائر الصانعين">
  <div class="container block" style="padding-top:2rem;max-width:1280px">
    <div class="section-head">
      <span class="kicker">🧪 مختبر الصانعين — Maker Canvas</span>
      <h2>ركّب دائرتك بالسحب والتوصيل</h2>
      <p>أضف المكونات، اسحبها، وانقر طرفًا ثم طرفًا آخر لرسم سلك. <span id="wbCloud" class="pill">…</span></p>
    </div>

    <div id="wbRemix" class="card wb-remix" hidden></div>

    <!-- Toolbar -->
    <div class="card wb-tools">
      <div class="wb-row">
        <label>🏷️ اسم المشروع <input id="wbTitle" placeholder="مثلًا: PBX-36 نسختي الأولى" /></label>
        <label>🎨 لون السلك
          <select id="wbColor">
            <option value="#ef4444">🔴 أحمر (+)</option>
            <option value="#94a3b8">⚫ أسود (GND)</option>
            <option value="#f59e0b">🟠 برتقالي (Latched)</option>
            <option value="#38bdf8">🔵 أزرق (+12V)</option>
            <option value="#22c55e">🟢 أخضر (Logic)</option>
          </select>
        </label>
      </div>
      <div class="wb-row wb-simbar">
        <button id="wbStart" class="btn btn-amber wb-btn">▶️ بدء المحاكاة</button>
        <button id="wbStop" class="btn btn-ghost wb-btn" hidden>⏹️ إيقاف</button>
        <span id="wbSimState" class="pill">⏸️ متوقف</span>
        <span id="wbTier" class="pill cyan">…</span>
        <span class="wb-zoom">
          <button id="wbZoomOut" aria-label="تصغير">−</button>
          <button id="wbZoomReset" aria-label="إعادة العرض">⌂ <span id="wbZoomLvl" dir="ltr">100%</span></button>
          <button id="wbZoomIn" aria-label="تكبير">＋</button>
        </span>
      </div>
      <div class="wb-row">
        <button id="wbValidate" class="btn btn-amber wb-btn">🔍 فحص التوصيل</button>
        <button id="wbSave" class="btn btn-cyan wb-btn">💾 حفظ المشروع</button>
        <button id="wbShare" class="btn btn-ghost wb-btn">🔗 مشاركة</button>
        <button id="wbClear" class="btn btn-ghost wb-btn">🧹 مسح</button>
        <span id="wbMsg" class="wb-msg"></span>
      </div>
      <div class="wb-palette" id="wbPalette"></div>
      <p class="wb-help">🖱️ انقر طرفًا (يلمع) ثم الطرف الثاني لرسم سلك • نقرة مزدوجة / زر يمين على سلك لحذفه • اسحب المكونات من رأسها • <b>▶️ ابدأ المحاكاة</b> ثم انقر الأزرار للتبديل • اسحب الخلفية للتحريك، العجلة/القرص للتقريب • ⟳ لتدوير المكون • يعمل باللمس 📱</p>
    </div>

    <!-- Canvas -->
    <div id="wbCanvas" class="wb-canvas">
      <svg id="wbSvg"></svg>
      <canvas id="wbFx" aria-hidden="true"></canvas>
      <div id="wbNodes"></div>
    </div>
    <div id="wbAlert" class="wb-alert" hidden></div>
    <VoiceAI />
  </div>
</BaseLayout>

<script type="module" define:vars={{ SUPA_URL, SUPA_ANON }}>
  import { createClient } from '/vendor/supabase.js';
  import { localSaveProject, localGetProject, uid } from '/vendor/wb-store.js';
  import { renderPart } from '/vendor/hardware-graphics.js';
  import { sniffDevice } from '/vendor/device-sniffer.js';
  let gfxTier = 'eco';
  try { gfxTier = sniffDevice().tier; } catch (e) { gfxTier = 'eco'; }

  const isSupabaseConfigured = Boolean(SUPA_URL && SUPA_ANON);
  let supabase = null;
  try {
    if (isSupabaseConfigured) supabase = createClient(SUPA_URL, SUPA_ANON);
  } catch (e) { supabase = null; }

  const PARTS = {
    battery: { name: '🔋 Battery 10S', sub: '36V 10.4Ah • XT60', c: '#22c55e',
      terms: [{ id: 'plus', label: '+36V', net: 'PWR', side: 'r', pos: .3 }, { id: 'gnd', label: 'GND', net: 'GND', side: 'r', pos: .7 }] },
    mppt: { name: '☀️ LTC3780 MPPT', sub: 'Solar IN • Batt OUT', c: '#f59e0b',
      terms: [{ id: 'sol+', label: 'S+', net: 'PWR', side: 'l', pos: .3 }, { id: 'sol-', label: 'S-', net: 'GND', side: 'l', pos: .7 },
              { id: 'out+', label: 'B+', net: 'PWR', side: 'r', pos: .3 }, { id: 'out-', label: 'B-', net: 'GND', side: 'r', pos: .7 }] },
    latch: { name: '🔌 0.00mA Latch', sub: 'IRF4905 • TL431', c: '#a855f7',
      terms: [{ id: 'in', label: 'IN+', net: 'PWR', side: 'l', pos: .3 }, { id: 'gate', label: 'GATE', net: 'SIG', side: 'l', pos: .7 },
              { id: 'out', label: 'OUT+', net: 'PWR', side: 'r', pos: .35 }, { id: 'gnd', label: 'GND', net: 'GND', side: 'r', pos: .7 }] },
    usb: { name: '⚡ USB-C PD 100W', sub: 'IP2368', c: '#38bdf8',
      terms: [{ id: 'vin', label: 'V+', net: 'PWR', side: 'l', pos: .35 }, { id: 'gnd', label: 'GND', net: 'GND', side: 'l', pos: .65 },
              { id: 'usbc', label: 'USB-C', net: 'SIG', side: 'r', pos: .5 }] },
    buck: { name: '🔽 Buck 12V/10A', sub: 'Vin • Vout', c: '#38bdf8',
      terms: [{ id: 'vin', label: 'Vin', net: 'PWR', side: 'l', pos: .35 }, { id: 'gnd', label: 'GND', net: 'GND', side: 'l', pos: .65 },
              { id: 'vout', label: '12V', net: 'PWR', side: 'r', pos: .5 }] },
    wago: { name: '🔗 WAGO 221', sub: '3-port bus', c: '#eab308',
      terms: [{ id: 'p1', label: '1', net: 'BUS', side: 'l', pos: .5 }, { id: 'p2', label: '2', net: 'BUS', side: 'r', pos: .3 }, { id: 'p3', label: '3', net: 'BUS', side: 'r', pos: .7 }] },
    meter: { name: '📟 Voltmeter', sub: 'DC 0-100V', c: '#f43f5e',
      terms: [{ id: 'v+', label: 'R+', net: 'PWR', side: 'l', pos: .4 }, { id: 'v-', label: 'B-', net: 'GND', side: 'l', pos: .6 }] },
    button: { name: '🔘 Pushbutton 16mm', sub: 'COM/NO/NC', c: '#94a3b8',
      terms: [{ id: 'com', label: 'COM', net: 'SIG', side: 'l', pos: .5 }, { id: 'no', label: 'NO', net: 'SIG', side: 'r', pos: .3 }, { id: 'nc', label: 'NC', net: 'SIG', side: 'r', pos: .7 }] },
  };

  const canvas = document.getElementById('wbCanvas');
  const svg = document.getElementById('wbSvg');
  const layer = document.getElementById('wbNodes');
  const msg = document.getElementById('wbMsg');
  const alertBox = document.getElementById('wbAlert');
  const titleInput = document.getElementById('wbTitle');
  const colorSel = document.getElementById('wbColor');
  const cloudPill = document.getElementById('wbCloud');
  const fxCanvas = document.getElementById('wbFx');
  const fx = fxCanvas.getContext('2d');
  const tierPill = document.getElementById('wbTier');
  let fxRAF = 0;
  const particles = [];

  function paintTier() {
    if (!tierPill) return;
    tierPill.textContent = gfxTier === 'high' ? '⚡ أداء عالٍ (60fps)' : '🌱 وضع اقتصادي';
    tierPill.className = 'pill ' + (gfxTier === 'high' ? 'amber' : 'green');
  }

  function fxResize() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    fxCanvas.width = Math.max(1, Math.round(r.width * dpr));
    fxCanvas.height = Math.max(1, Math.round(r.height * dpr));
    fx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function fxSpawn() {
    particles.length = 0;
    const paths = svg.querySelectorAll('path');
    paths.forEach((p, i) => {
      try {
        const len = p.getTotalLength();
        if (!len || len < 10) return;
        const n = Math.min(4, Math.max(2, Math.round(len / 90)));
        for (let k = 0; k < n; k++) {
          if (particles.length >= 120) return;
          particles.push({ p, len, t: (i * 0.37 + k / n) % 1, sp: 0.9 + ((i + k) % 3) * 0.35, c: p.getAttribute('stroke') || '#38bdf8' });
        }
      } catch (e) {}
    });
  }

  function fxFrame() {
    if (!simOn || gfxTier !== 'high') { fxRAF = 0; return; }
    const r = canvas.getBoundingClientRect();
    fx.clearRect(0, 0, r.width, r.height);
    fx.save();
    fx.shadowBlur = 10;
    for (const pt of particles) {
      pt.t = (pt.t + 0.008 * pt.sp) % 1;
      try {
        const pos = pt.p.getPointAtLength(pt.t * pt.len);
        fx.shadowColor = pt.c;
        fx.fillStyle = '#ffffff';
        fx.beginPath();
        fx.arc(pos.x, pos.y, 2.2, 0, 6.2832);
        fx.fill();
        fx.fillStyle = pt.c;
        fx.beginPath();
        fx.arc(pos.x, pos.y, 1.2, 0, 6.2832);
        fx.fill();
      } catch (e) {}
    }
    fx.restore();
    fxRAF = requestAnimationFrame(fxFrame);
  }

  function fxStart() {
    paintTier();
    if (gfxTier !== 'high') return;
    fxResize();
    fxSpawn();
    if (!fxRAF && !document.hidden) fxRAF = requestAnimationFrame(fxFrame);
  }

  function fxStop() {
    if (fxRAF) cancelAnimationFrame(fxRAF);
    fxRAF = 0;
    particles.length = 0;
    try { fx.clearRect(0, 0, fxCanvas.width, fxCanvas.height); } catch (e) {}
  }
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { if (fxRAF) cancelAnimationFrame(fxRAF); fxRAF = 0; }
    else if (simOn && gfxTier === 'high' && !fxRAF) fxRAF = requestAnimationFrame(fxFrame);
  });
  window.addEventListener('resize', () => { if (simOn) fxResize(); });
  paintTier();

  let state = { nodes: [], wires: [] };
  let pending = null;       // terminal key awaiting pair
  let editingId = null;     // loaded project id (own)
  let forkedFrom = null;    // original id when remixing
  let dragNode = null, dragDX = 0, dragDY = 0;
  let session = null;
  // simulation + viewport state
  let simOn = false;
  const latchMap = {};      // latch node id -> latched bool
  const view = { x: 0, y: 0, k: 1 };
  let panState = null;
  const pinchPts = new Map();
  let voltMap = {};         // union root -> volts (sim)
  const SIDES = ['l', 't', 'r', 'b'];
  const effSide = (t, rot) => SIDES[(SIDES.indexOf(t.side) + (((rot || 0) % 4) + 4) % 4) % 4];

  const esc = (s) => String(s ?? '').replace(/</g, '&lt;');
  const termKey = (n, t) => n + ':' + t;
  function say(t, ok) { msg.textContent = t; msg.style.color = ok === false ? '#fca5a5' : 'var(--green)'; }

  function beep(bad) {
    try {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return;
      const ctx = new Ctx(), o = ctx.createOscillator(), g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = bad ? 160 : 620;
      g.gain.setValueAtTime(0.08, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + (bad ? 0.5 : 0.2));
      o.start(); o.stop(ctx.currentTime + (bad ? 0.5 : 0.2));
    } catch (e) {}
  }

  /* ---------------- palette ---------------- */
  const pal = document.getElementById('wbPalette');
  Object.entries(PARTS).forEach(([type, p]) => {
    const b = document.createElement('button');
    b.className = 'wb-part-btn';
    b.innerHTML = `<b>${esc(p.name)}</b><small>${esc(p.sub)}</small><span>＋ إضافة</span>`;
    b.style.borderColor = p.c;
    b.addEventListener('click', () => addNode(type));
    pal.appendChild(b);
  });

  function addNode(type, x, y) {
    const n = layer.clientWidth || 600;
    state.nodes.push({
      id: uid(), type,
      x: x ?? (40 + (state.nodes.length * 60) % (Math.max(n - 220, 100))),
      y: y ?? (40 + (state.nodes.length * 47) % 380),
    });
    render();
  }

  /* ---------------- render ---------------- */
  function render() {
    layer.innerHTML = '';
    state.nodes.forEach((nd) => {
      const p = PARTS[nd.type];
      if (!p) return;
      const rot = ((nd.rot || 0) % 4 + 4) % 4;
      const el = document.createElement('div');
      el.className = 'wb-node' + (nd.pressed ? ' pressed' : '');
      el.style.left = nd.x + 'px';
      el.style.top = nd.y + 'px';
      el.style.borderColor = p.c;
      el.dataset.nid = nd.id;
      el.innerHTML = `<div class="wb-node-head" style="background:${p.c}22"><b>${esc(p.name)}</b><span><button data-rot title="تدوير 90°">⟳</button><button data-delnode title="حذف">✕</button></span></div>
        <div class="wb-node-graphic" style="transform:rotate(${rot * 90}deg)">${renderPart(nd.type, nd.id.replace(/[^a-z0-9]/gi, ''))}</div>
        <div class="wb-node-sub">${esc(p.sub)}${nd.type === 'button' ? (nd.pressed ? ' • <b style="color:var(--green)">مضغوط</b>' : ' • محرر') : ''}</div>` +
        p.terms.map((t) => {
          const s = effSide(t, rot);
          return `<button class="wb-term side-${s}" data-t="${esc(nd.id)}:${esc(t.id)}" style="${s === 'l' ? 'left' : s === 'r' ? 'right' : s === 't' ? 'top' : 'bottom'}:-7px;${s === 'l' || s === 'r' ? 'top' : 'left'}:${t.pos * 100}%" title="${esc(t.label)}">${esc(t.label)}</button>`;
        }).join('');
      layer.appendChild(el);
    });
    applyView();
    drawWires();
  }

  function applyView() {
    layer.style.transform = `translate(${view.x}px,${view.y}px) scale(${view.k})`;
    layer.style.transformOrigin = '0 0';
    const g = Math.max(8, 22 * view.k);
    canvas.style.backgroundPosition = `${view.x}px ${view.y}px`;
    canvas.style.backgroundSize = `${g}px ${g}px`;
    const zl = document.getElementById('wbZoomLvl');
    if (zl) zl.textContent = Math.round(view.k * 100) + '%';
  }

  function zoomAt(mx, my, ratio) {
    const k2 = Math.max(0.4, Math.min(2, view.k * ratio));
    const r = k2 / view.k;
    view.x = mx - (mx - view.x) * r;
    view.y = my - (my - view.y) * r;
    view.k = k2;
    applyView();
    drawWires();
  }

  function termXY(key) {
    const el = layer.querySelector(`[data-t="${CSS.escape(key)}"]`);
    if (!el) return null;
    const c = canvas.getBoundingClientRect(), r = el.getBoundingClientRect();
    return { x: r.left - c.left + r.width / 2, y: r.top - c.top + r.height / 2 };
  }

  function drawWires() {
    svg.setAttribute('viewBox', `0 0 ${canvas.clientWidth} ${canvas.clientHeight}`);
    svg.innerHTML = '';
    state.wires.forEach((w) => {
      const a = termXY(w.a), b = termXY(w.b);
      if (!a || !b) return;
      const dx = Math.max(40, Math.abs(b.x - a.x) / 2);
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', `M ${a.x} ${a.y} C ${a.x + dx} ${a.y}, ${b.x - dx} ${b.y}, ${b.x} ${b.y}`);
      path.setAttribute('stroke', w.color);
      path.setAttribute('stroke-width', '3.5');
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke-linecap', 'round');
      path.dataset.wid = w.id;
      path.style.cursor = 'pointer';
      const del = (e) => { e.preventDefault(); e.stopPropagation(); state.wires = state.wires.filter((x) => x.id !== w.id); drawWires(); if (simOn) simTick(); };
      path.addEventListener('dblclick', del);
      path.addEventListener('contextmenu', del);
      svg.appendChild(path);
    });
    // live voltmeters: sim → computed node voltage; idle → 36.0 if wired
    const live = new Set();
    state.wires.forEach((w) => { live.add(w.a); live.add(w.b); });
    state.nodes.forEach((nd) => {
      if (nd.type !== 'meter') return;
      let txt = '--.-', col = '#7f1d1d';
      if (simOn && voltMap[nd.id + ':v+'] !== undefined) {
        const v = voltMap[nd.id + ':v+'];
        txt = v.toFixed(1); col = v > 0 ? '#ef4444' : '#7f1d1d';
      } else if (!simOn && live.has(nd.id + ':v+')) {
        txt = '36.0'; col = '#ef4444';
      }
      layer.querySelectorAll(`[data-nid="${CSS.escape(nd.id)}"] .wb-volt`).forEach((t) => {
        t.textContent = txt;
        t.setAttribute('fill', col);
      });
    });
    // pending highlight
    layer.querySelectorAll('.wb-term').forEach((el) => {
      el.classList.toggle('pending', el.getAttribute('data-t') === pending);
    });
  }

  /* ---------------- interactions ---------------- */
  layer.addEventListener('click', (e) => {
    const rot = e.target.closest('[data-rot]');
    if (rot) {
      const nid = rot.closest('.wb-node').dataset.nid;
      const nd = state.nodes.find((n) => n.id === nid);
      if (nd) { nd.rot = (((nd.rot || 0) + 1) % 4 + 4) % 4; render(); if (simOn) simTick(); }
      return;
    }
    const del = e.target.closest('[data-delnode]');
    if (del) {
      const nid = del.closest('.wb-node').dataset.nid;
      state.nodes = state.nodes.filter((n) => n.id !== nid);
      state.wires = state.wires.filter((w) => !w.a.startsWith(nid + ':') && !w.b.startsWith(nid + ':'));
      render();
      if (simOn) simTick();
      return;
    }
    const nodeBody = e.target.closest('.wb-node');
    const term = e.target.closest('.wb-term');
    if (!term && nodeBody && simOn) {
      // tactile button toggle during simulation (Wokwi style)
      const nd = state.nodes.find((n) => n.id === nodeBody.dataset.nid);
      if (nd && nd.type === 'button') {
        nd.pressed = !nd.pressed;
        beep(false);
        render();
        simTick();
        say(nd.pressed ? '🔘 الزر مضغوط (NO مغلق)' : '🔘 الزر محرر (NC مغلق)', true);
        return;
      }
    }
    if (!term) {
      if (pending && !e.target.closest('.wb-node')) { pending = null; drawWires(); }
      return;
    }
    const key = term.getAttribute('data-t');
    if (!pending) { pending = key; drawWires(); say('اختر الطرف الثاني…'); return; }
    if (pending === key) { pending = null; drawWires(); return; }
    state.wires.push({ id: uid(), a: pending, b: key, color: colorSel.value });
    pending = null;
    drawWires();
    if (simOn) simTick(true);
    say(`سلك جديد (${state.wires.length}) ✅`, true);
  });

  layer.addEventListener('pointerdown', (e) => {
    const head = e.target.closest('.wb-node-head');
    if (!head || e.target.closest('[data-delnode]') || e.target.closest('[data-rot]')) return;
    const nodeEl = head.closest('.wb-node');
    const nid = nodeEl.dataset.nid;
    const nd = state.nodes.find((n) => n.id === nid);
    if (!nd) return;
    dragNode = nd;
    const r = nodeEl.getBoundingClientRect(), c = canvas.getBoundingClientRect();
    dragDX = (e.clientX - r.left) / view.k;
    dragDY = (e.clientY - r.top) / view.k;
    nodeEl.setPointerCapture?.(e.pointerId);
    e.preventDefault();
  });

  // canvas pan (background) + pinch zoom; node drag stays on window handler
  canvas.addEventListener('pointerdown', (e) => {
    if (e.target.closest('.wb-node') || e.target.closest('#wbSvg path')) return;
    pinchPts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinchPts.size === 2) {
      const [a, b] = [...pinchPts.values()];
      panState = { pinch: true, d0: Math.hypot(a.x - b.x, a.y - b.y), k0: view.k, mx: (a.x + b.x) / 2, my: (a.y + b.y) / 2, x0: view.x, y0: view.y };
    } else {
      panState = { sx: e.clientX, sy: e.clientY, x0: view.x, y0: view.y, moved: false };
    }
    canvas.setPointerCapture?.(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!pinchPts.has(e.pointerId)) return;
    pinchPts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (!panState) return;
    if (panState.pinch && pinchPts.size >= 2) {
      const [a, b] = [...pinchPts.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y) || 1;
      const c = canvas.getBoundingClientRect();
      const mx = (a.x + b.x) / 2 - c.left, my = (a.y + b.y) / 2 - c.top;
      const k2 = Math.max(0.4, Math.min(2, panState.k0 * d / panState.d0));
      const r = k2 / panState.k0;
      view.x = mx - (mx - panState.x0) * r;
      view.y = my - (my - panState.y0) * r;
      view.k = k2;
      applyView();
      drawWires();
      return;
    }
    if (!panState.pinch) {
      const dx = e.clientX - panState.sx, dy = e.clientY - panState.sy;
      if (Math.abs(dx) + Math.abs(dy) > 4) panState.moved = true;
      view.x = panState.x0 + dx;
      view.y = panState.y0 + dy;
      applyView();
      drawWires();
    }
  });
  const endPan = (e) => {
    pinchPts.delete(e.pointerId);
    if (pinchPts.size < 2) panState = null;
    if (pinchPts.size === 1) {
      const [p] = [...pinchPts.values()];
      panState = { sx: p.x, sy: p.y, x0: view.x, y0: view.y, moved: true };
    }
  };
  canvas.addEventListener('pointerup', endPan);
  canvas.addEventListener('pointercancel', endPan);
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    const c = canvas.getBoundingClientRect();
    zoomAt(e.clientX - c.left, e.clientY - c.top, Math.exp(-e.deltaY * 0.0012));
  }, { passive: false });

  window.addEventListener('pointermove', (e) => {
    if (!dragNode) return;
    const c = canvas.getBoundingClientRect();
    dragNode.x = Math.max(0, (e.clientX - c.left - view.x) / view.k - dragDX);
    dragNode.y = Math.max(0, (e.clientY - c.top - view.y) / view.k - dragDY);
    const el = layer.querySelector(`[data-nid="${CSS.escape(dragNode.id)}"]`);
    if (el) { el.style.left = dragNode.x + 'px'; el.style.top = dragNode.y + 'px'; }
    drawWires();
  });
  window.addEventListener('pointerup', () => { dragNode = null; });
  window.addEventListener('wattouna:ai-add-part', (e) => {
    const type = e.detail?.type;
    if (!type || !PARTS[type]) return;
    addNode(type);
    say(`🤖 أضاف المساعد: ${PARTS[type].name}`, true);
    if (simOn) simTick();
  });

  window.addEventListener('resize', drawWires);

  /* ---------------- validate (short-circuit check) ---------------- */
  function buildNets(btnLinks, latchLinks) {
    const parent = {};
    const find = (x) => { parent[x] = parent[x] || x; return parent[x] === x ? x : (parent[x] = find(parent[x])); };
    const uni = (a, b) => { parent[find(a)] = find(b); };
    const netOf = {};
    state.nodes.forEach((nd) => {
      (PARTS[nd.type]?.terms || []).forEach((t) => { netOf[termKey(nd.id, t.id)] = t.net; parent[termKey(nd.id, t.id)] = termKey(nd.id, t.id); });
    });
    // common-bus parts (WAGO): all BUS terminals of one node are internally joined
    state.nodes.forEach((nd) => {
      const bus = (PARTS[nd.type]?.terms || []).filter((t) => t.net === 'BUS').map((t) => termKey(nd.id, t.id));
      for (let i = 1; i < bus.length; i++) uni(bus[0], bus[i]);
    });
    state.wires.forEach((w) => { if (netOf[w.a] && netOf[w.b]) uni(w.a, w.b); });
    (btnLinks || []).forEach(([a, b]) => { if (netOf[a] && netOf[b]) uni(a, b); });
    (latchLinks || []).forEach(([a, b]) => { if (netOf[a] && netOf[b]) uni(a, b); });
    const sets = {};
    Object.keys(netOf).forEach((k) => { const r = find(k); (sets[r] = sets[r] || []).push(k); });
    return { sets, netOf, find };
  }
  function nets() {
    const { sets, netOf } = buildNets([], []);
    return { sets, netOf };
  }
  function findShort(sets, netOf) {
    for (const members of Object.values(sets)) {
      const hasP = members.some((m) => netOf[m] === 'PWR');
      const hasG = members.some((m) => netOf[m] === 'GND');
      if (hasP && hasG) return members;
    }
    return null;
  }

  /* ---------------- simulation runtime (PhET style) ---------------- */
  const simPill = document.getElementById('wbSimState');
  const btnStart = document.getElementById('wbStart');
  const btnStop = document.getElementById('wbStop');

  function setSimUI() {
    btnStart.hidden = simOn;
    btnStop.hidden = !simOn;
    simPill.textContent = simOn ? '🟢 المحاكاة تعمل — انقر الأزرار!' : '⏸️ متوقف';
    simPill.className = 'pill ' + (simOn ? 'green' : '');
    svg.classList.toggle('sim-on', simOn);
    if (!simOn) svg.classList.remove('sim-short');
  }

  function sparkAt(x, y) {
    const d = document.createElement('div');
    d.className = 'wb-spark';
    d.textContent = '✸';
    d.style.left = x + 'px';
    d.style.top = y + 'px';
    canvas.appendChild(d);
    d.addEventListener('animationend', () => d.remove());
    setTimeout(() => d.remove(), 1500);
  }

  function shortWireXY() {
    // prefer a wire directly joining PWR and GND terminals
    const { netOf } = nets();
    for (const w of state.wires) {
      const na = netOf[w.a], nb = netOf[w.b];
      if ((na === 'PWR' && nb === 'GND') || (na === 'GND' && nb === 'PWR')) {
        const a = termXY(w.a), b = termXY(w.b);
        if (a && b) return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      }
    }
    const c = canvas.getBoundingClientRect();
    return { x: c.width / 2, y: c.height / 2 };
  }

  function shortTrip() {
    const p = shortWireXY();
    sparkAt(p.x, p.y);
    svg.classList.add('sim-short');
    setTimeout(() => svg.classList.remove('sim-short'), 1300);
    beep(true);
    alertBox.hidden = false;
    alertBox.className = 'wb-alert bad';
    alertBox.innerHTML = '⚡ <b>ماس كهربائي أثناء المحاكاة!</b> توقفت المحاكاة للحماية — افصل التماس بين (+) و GND ثم أعد التشغيل.';
    setTimeout(() => { alertBox.hidden = true; }, 8000);
  }

  function simTick(fromWire) {
    if (!simOn) return;
    // 1. button conduction: pressed → COM–NO, released → COM–NC
    const btnLinks = [];
    state.nodes.forEach((nd) => {
      if (nd.type !== 'button') return;
      btnLinks.push(nd.pressed ? [nd.id + ':com', nd.id + ':no'] : [nd.id + ':com', nd.id + ':nc']);
    });
    // 2. base pass: evaluate gate nets
    let r = buildNets(btnLinks, []);
    const battNode = state.nodes.find((n) => n.type === 'battery');
    const plusSet = battNode ? r.find(battNode.id + ':plus') : null;
    const gndSet = battNode ? r.find(battNode.id + ':gnd') : null;
    // 3. latch memory: gate energized → latch on; gate grounded → latch off
    const latchLinks = [];
    state.nodes.forEach((nd) => {
      if (nd.type !== 'latch') return;
      const g = r.find(nd.id + ':gate');
      if (plusSet && g === plusSet) latchMap[nd.id] = true;
      else if (gndSet && g === gndSet) latchMap[nd.id] = false;
      if (latchMap[nd.id]) latchLinks.push([nd.id + ':in', nd.id + ':out']);
    });
    // 4. full pass with latch conduction
    r = buildNets(btnLinks, latchLinks);
    const short = findShort(r.sets, r.netOf);
    if (short) {
      stopSim();
      shortTrip();
      say('❌ ماس أثناء المحاكاة — توقفت!', false);
      return;
    }
    // 5. voltage propagation: battery 36V, buck 12V
    voltMap = {};
    if (battNode) {
      const p36 = r.find(battNode.id + ':plus');
      voltMap[p36] = 36.0;
      state.nodes.forEach((nd) => {
        if (nd.type === 'buck' && r.find(nd.id + ':vin') === p36) voltMap[r.find(nd.id + ':vout')] = 12.0;
      });
    }
    // meter readings keyed by terminal for drawWires
    state.nodes.forEach((nd) => {
      if (nd.type !== 'meter') return;
      const root = r.find(nd.id + ':v+');
      voltMap[nd.id + ':v+'] = voltMap[root] !== undefined ? voltMap[root] : 0.0;
    });
    drawWires();
    if (simOn && gfxTier === 'high') { fxSpawn(); if (!fxRAF && !document.hidden) fxRAF = requestAnimationFrame(fxFrame); }
    const latched = Object.values(latchMap).some(Boolean);
    say(latched ? '🟢 المحاكاة تعمل — القفل ممسوك، التيار يسري' : '🟢 المحاكاة تعمل — انقر زرًا لمسك القفل', true);
  }

  function startSim() {
    const { sets, netOf } = nets();
    if (findShort(sets, netOf)) {
      shortTrip();
      say('❌ ماس كهربائي — أصلحه قبل التشغيل!', false);
      return;
    }
    if (!state.nodes.some((n) => n.type === 'battery')) {
      say('أضف بطارية أولًا! 🔋', false);
      return;
    }
    simOn = true;
    setSimUI();
    beep(false);
    simTick();
    fxStart();
  }
  function stopSim() {
    simOn = false;
    voltMap = {};
    fxStop();
    setSimUI();
    drawWires();
  }

  btnStart.addEventListener('click', startSim);
  btnStop.addEventListener('click', () => { stopSim(); say('⏸️ توقفت المحاكاة'); });
  document.getElementById('wbZoomIn').addEventListener('click', () => {
    const c = canvas.getBoundingClientRect();
    zoomAt(c.width / 2, c.height / 2, 1.25);
  });
  document.getElementById('wbZoomOut').addEventListener('click', () => {
    const c = canvas.getBoundingClientRect();
    zoomAt(c.width / 2, c.height / 2, 0.8);
  });
  document.getElementById('wbZoomReset').addEventListener('click', () => {
    view.x = 0; view.y = 0; view.k = 1;
    applyView();
    drawWires();
  });

  document.getElementById('wbValidate').addEventListener('click', () => {
    const { sets, netOf } = nets();
    const short = findShort(sets, netOf);
    alertBox.hidden = false;
    if (short) {
      alertBox.className = 'wb-alert bad';
      alertBox.innerHTML = `⚡ <b>ماس كهربائي!</b> قطب (+) متصل مباشرة بـ GND عبر ${short.length} أطراف. راجع الأسلاك الحمراء/السوداء قبل التشغيل.`;
      beep(true);
      say('❌ ماس كهربائي مكتشف!', false);
    } else {
      const floating = Object.values(netOf).filter((n, i, arr) => n === 'PWR').length;
      alertBox.className = 'wb-alert ok';
      alertBox.innerHTML = `✅ لا ماس مكتشف — ${state.wires.length} سلك، ${state.nodes.length} مكوّنات. تحقق دائمًا بالملتيميتر قبل التغذية الحقيقية.`;
      beep(false);
      say('✅ الدارة سليمة ظاهريًا', true);
    }
    setTimeout(() => { alertBox.hidden = true; }, 7000);
  });

  /* ---------------- save / share / load ---------------- */
  async function cloudSession() {
    try {
      if (localStorage.getItem('wattouna-offline') === '1') return null; // workshop mode
    } catch (e) {}
    if (!isSupabaseConfigured || !supabase) return null;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      return session;
    } catch (e) { return null; }
  }

  document.getElementById('wbSave').addEventListener('click', async () => {
    const title = titleInput.value.trim() || 'دارة بدون عنوان';
    if (!state.nodes.length) { say('أضف مكونًا أولًا!', false); return; }
    say('⏳ جارٍ الحفظ…');
    const s = await cloudSession();
    if (s && supabase) {
      try {
        const mine = editingId ? (await supabase.from('projects').select('id').eq('id', editingId).eq('author_id', s.user.id).single()).data : null;
        const payload = { title, description: `${state.nodes.length} components, ${state.wires.length} wires`, canvas_state: state, is_public: true };
        let id = editingId;
        if (mine) {
          const { error } = await supabase.from('projects').update(payload).eq('id', editingId);
          if (error) throw error;
        } else {
          const { data, error } = await supabase.from('projects').insert({ ...payload, author_id: s.user.id, forked_from: forkedFrom }).select('id').single();
          if (error) throw error;
          id = data.id;
          editingId = id;
          try {
            const { data: prof } = await supabase.from('profiles').select('upcycled_energy_wh').eq('id', s.user.id).single();
            await supabase.from('profiles').update({ upcycled_energy_wh: Number(prof?.upcycled_energy_wh || 0) + 336 }).eq('id', s.user.id);
          } catch (e) {}
        }
        say('✅ حُفظ في السحابة! +336Wh 🌱', true);
        history.replaceState(null, '', '/workbench?id=' + id);
        return;
      } catch (e) { say('❌ ' + (e.message || e), false); return; }
    }
    const p = { id: editingId || uid(), title, description: '', canvas_state: state, forked_from: forkedFrom, author_name: 'محلي', created_at: new Date().toISOString(), updated_at: new Date().toISOString() };
    localSaveProject(p);
    editingId = p.id;
    history.replaceState(null, '', '/workbench?id=' + p.id);
    say('✅ حُفظ محليًا (اربط Supabase للسحابة)', true);
  });

  document.getElementById('wbShare').addEventListener('click', async () => {
    if (!editingId) { say('احفظ المشروع أولًا لمشاركته!', false); return; }
    const url = window.location.origin + '/workbench?id=' + editingId;
    try { await navigator.clipboard.writeText(url); say('✅ نُسخ رابط المشاركة!', true); }
    catch (e) { prompt('انسخ الرابط:', url); }
  });

  document.getElementById('wbClear').addEventListener('click', () => {
    if (!state.nodes.length || confirm('مسح اللوحة بالكامل؟')) {
      stopSim();
      for (const k of Object.keys(latchMap)) delete latchMap[k];
      state = { nodes: [], wires: [] };
      editingId = null; forkedFrom = null;
      history.replaceState(null, '', '/workbench');
      document.getElementById('wbRemix').hidden = true;
      render();
      say('لوحة فارغة — أضف مكونات 🧩');
    }
  });

  /* ---------------- load (?id= / ?fork=) ---------------- */
  async function loadById(id) {
    if (isSupabaseConfigured && supabase) {
      try {
        const { data, error } = await supabase.from('projects').select('*, profiles(username,display_name)').eq('id', id).single();
        if (error) throw error;
        return { ...data, author_name: data.profiles?.display_name || data.profiles?.username || 'صانع' };
      } catch (e) {}
    }
    return localGetProject(id);
  }

  (async function init() {
    let ws = false;
    try { ws = localStorage.getItem('wattouna-offline') === '1'; } catch (e) {}
    cloudPill.textContent = ws ? '🧰 ورشة دون اتصال' : (isSupabaseConfigured && supabase) ? '☁️ السحابة مفعّلة' : '💾 وضع محلي';
    cloudPill.className = 'pill ' + (ws ? 'amber' : (isSupabaseConfigured && supabase) ? 'green' : 'amber');
    const q = new URLSearchParams(location.search);
    const loadId = q.get('id') || q.get('fork');
    const isFork = q.has('fork');
    if (loadId) {
      const p = await loadById(loadId);
      if (p?.canvas_state?.nodes) {
        state = p.canvas_state;
        titleInput.value = (isFork ? 'Remix of ' : '') + (p.title || '');
        const s = await cloudSession();
        const own = s && p.author_id && p.author_id === s.user.id && !isFork;
        const box = document.getElementById('wbRemix');
        if (own) {
          editingId = p.id;
          box.hidden = true;
        } else {
          forkedFrom = p.id;
          box.hidden = false;
          box.innerHTML = `🍴 تصميم <b>${esc(p.title || '')}</b> للصانع <b>${esc(p.author_name || '')}</b> — عدّل بحرية ثم احفظ لينُشر كنسخة (Remix) باسمك.`;
        }
        render();
        say(`📂 تم تحميل «${p.title || ''}»`, true);
        return;
      }
      say('تعذر تحميل المشروع — تحقق من الرابط', false);
    }
    // starter demo: battery -> latch -> buck
    addNode('battery', 40, 80);
    addNode('latch', 260, 80);
    addNode('buck', 490, 80);
    state.wires.push(
      { id: uid(), a: state.nodes[0].id + ':plus', b: state.nodes[1].id + ':in', color: '#ef4444' },
      { id: uid(), a: state.nodes[0].id + ':gnd', b: state.nodes[1].id + ':gnd', color: '#94a3b8' },
      { id: uid(), a: state.nodes[1].id + ':out', b: state.nodes[2].id + ':vin', color: '#f59e0b' },
    );
    titleInput.value = 'PBX-36 starter';
    render();
  })();
</script>

