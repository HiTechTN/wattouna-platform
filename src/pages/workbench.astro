---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wattouna3DLab from '../components/Wattouna3DLab.astro';
---
<BaseLayout title="واطنا | المختبر السيبراني">
  
  <!-- 🚀 المختبر ثلاثي الأبعاد الجديد -->
  <Wattouna3DLab />

  <!-- مساحة العمل القديمة (تأخذ إضاءة ناسا من BaseLayout) -->
  <div class="cyber-panel" style="max-width: 1280px; margin: 20px auto; padding: 20px;">
    <h2 style="color: #06b6d4; font-family: monospace; text-shadow: 0 0 8px rgba(6,182,212,0.5);">⚡ مساحة العمل والتوصيل السريع</h2>
    <div id="canvas-container" style="min-height: 500px; position: relative;"></div>
  </div>

  <script src="/vendor/wattouna-canvas.js" is:inline></script>
</BaseLayout>
