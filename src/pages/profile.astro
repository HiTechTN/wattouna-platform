---
import BaseLayout from '../layouts/BaseLayout.astro';
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<BaseLayout title="ملفي الشخصي — Wattouna Makers">
  <div class="container block" style="padding-top:2.5rem">
    <div class="section-head">
      <span class="kicker">👤 فضاء الصانع</span>
      <h2>ملفي الشخصي</h2>
      <p>هويتك كصانع، أثرك من الطاقة المعاد تدويرها، ودوائرك المحفوظة.</p>
    </div>
    <div id="profRoot"><div class="card"><p>⏳ جارٍ التحميل…</p></div></div>
  </div>
</BaseLayout>

<script type="module" define:vars={{ SUPA_URL, SUPA_ANON }}>
  import { createClient } from '/vendor/supabase.js';
  import { localListProjects } from '/vendor/wb-store.js';

  const isSupabaseConfigured = Boolean(SUPA_URL && SUPA_ANON);
  let supabase = null;
  try {
    if (isSupabaseConfigured) supabase = createClient(SUPA_URL, SUPA_ANON);
  } catch (e) { supabase = null; }

  const root = document.getElementById('profRoot');
  const esc = (s) => String(s ?? '').replace(/</g, '&lt;');
  const fmtDate = (d) => { try { return new Date(d).toLocaleDateString('ar'); } catch (e) { return ''; } };
  const origin = window.location.origin;

  const NCOL = { battery: '#22c55e', mppt: '#f59e0b', latch: '#a855f7', usb: '#38bdf8', buck: '#38bdf8', wago: '#eab308', meter: '#f43f5e', button: '#94a3b8' };
  const WCOL = { '#ef4444': '#ef4444', '#94a3b8': '#94a3b8', '#f59e0b': '#f59e0b', '#38bdf8': '#38bdf8', '#22c55e': '#22c55e', '#a855f7': '#a855f7' };
  function miniThumb(st) {
    const nodes = (st && st.nodes) || [], wires = (st && st.wires) || [];
    const W2 = 220, H2 = 110;
    const T = {};
    let s = `<svg viewBox="0 0 ${W2} ${H2}" width="100%" height="86" aria-hidden="true"><rect width="${W2}" height="${H2}" style="fill:var(--canvas)"/>`;
    nodes.forEach((n, i) => {
      const x = 14 + (i % 4) * 52, y = 16 + Math.floor(i / 4) * 40;
      T[n.id] = { x: x + 20, y: y + 12 };
      s += `<rect x="${x}" y="${y}" width="40" height="24" rx="5" fill="${NCOL[n.type] || '#64748b'}" opacity=".85"/>`;
    });
    wires.forEach((w) => {
      const ka = (w.a || '').split(':')[0], kb = (w.b || '').split(':')[0];
      const a = T[ka], b = T[kb];
      if (!a || !b || ka === kb) return;
      s += `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${WCOL[w.color] || '#38bdf8'}" stroke-width="1.6" opacity=".9"/>`;
    });
    return s + '</svg>';
  }

  function projectCard(p, mine) {
    const st = p.canvas_state || {};
    const nn = (st.nodes || []).length, nw = (st.wires || []).length;
    return `<div class="card prof-card lift">
      ${miniThumb(st)}
      <b>${esc(p.title || 'دارة بدون عنوان')}</b>
      <small>🧩 ${nn} مكوّنات • 🔌 ${nw} أسلاك • 📅 ${fmtDate(p.created_at)}</small>
      ${p.forked_from ? `<small>🍴 منسوخة من <a href="/workbench?id=${p.forked_from}">التصميم الأصلي</a></small>` : ''}
      <div class="prof-actions">
        <a class="btn btn-cyan prof-mini" href="/workbench?id=${p.id}">فتح في المختبر</a>
        <button class="btn btn-ghost prof-mini" data-copy="${p.id}">🔗 مشاركة</button>
        ${mine ? `<button class="btn btn-ghost prof-mini" data-del="${p.id}">🗑️ حذف</button>` : ''}
      </div>
    </div>`;
  }

  function bindCards(scope) {
    scope.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      const url = origin + '/workbench?id=' + b.getAttribute('data-copy');
      try { await navigator.clipboard.writeText(url); b.textContent = '✅ تم النسخ!'; }
      catch (e) { prompt('انسخ الرابط:', url); }
      setTimeout(() => { b.textContent = '🔗 مشاركة'; }, 2000);
    }));
  }

  /* ---------- local demo mode ---------- */
  if (!isSupabaseConfigured || !supabase) {
    const local = localListProjects();
    root.innerHTML = `<div class="card"><span class="pill amber">☁️ وضع محلي — اربط Supabase للتفعيل الكامل</span>
      <p style="color:var(--muted)">مشاريعك محفوظة في هذا المتصفح فقط. انسخ <code dir="ltr">.env.example</code> إلى <code dir="ltr">.env</code> بمفاتيحك.</p></div>
      <h3>⚡ مشاريع محلية (${local.length})</h3>
      <div class="grid-3">${local.map((p) => projectCard(p, true)).join('') || '<div class="card">لا مشاريع بعد — <a href="/workbench">ابدأ في المختبر 🧪</a></div>'}</div>`;
    bindCards(root);
  } else {
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        root.innerHTML = `<div class="card" style="text-align:center;display:grid;gap:.8rem;justify-items:center">
          <div style="font-size:2.5rem">🔑</div><h3>سجل الدخول أولًا</h3>
          <p style="color:var(--muted)">GitHub للدخول الكامل، أو تابع كزائر بحفظ محلي.</p>
          <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center">
            <button class="btn btn-amber" id="profLogin">تسجيل الدخول</button>
            <button class="btn btn-ghost" id="profGuest">🚶 المتابعة كزائر</button>
          </div></div>`;
        document.getElementById('profLogin')?.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('wattouna:open-auth'));
        });
        document.getElementById('profGuest')?.addEventListener('click', () => {
          try { localStorage.setItem('wattouna-guest', '1'); } catch (e) {}
          location.href = '/workbench';
        });
        return;
      }
      const uid = session.user.id;
      let { data: prof } = await supabase.from('profiles').select('*').eq('id', uid).single();
      if (!prof) {
        const meta = session.user.user_metadata || {};
        const { data } = await supabase.from('profiles').upsert({
          id: uid,
          username: meta.user_name || session.user.email.split('@')[0],
          display_name: meta.full_name || meta.user_name || 'صانع جديد',
          avatar_url: meta.avatar_url || null,
        }, { onConflict: 'id' }).select().single();
        prof = data;
      }
      const { count: pubCount } = await supabase.from('projects').select('id', { count: 'exact', head: true }).eq('author_id', uid);
      const { data: mine } = await supabase.from('projects').select('*').eq('author_id', uid).order('updated_at', { ascending: false });
      const forked = (mine || []).filter((p) => p.forked_from);
      const avatar = prof?.avatar_url || session.user.user_metadata?.avatar_url;

      root.innerHTML = `
        <div class="pcb-banner prof-hero">
          <div class="prof-avatar-wrap">
            ${avatar ? `<img class="prof-avatar" src="${esc(avatar)}" alt="avatar" />` : '<span class="prof-avatar prof-ph">⚡</span>'}
          </div>
          <div style="flex:1;min-width:220px;text-align:center">
            <h2 style="margin:.2rem 0">${esc(prof?.display_name || 'صانع')}</h2>
            <p style="margin:.2rem 0;display:flex;gap:.4rem;justify-content:center;flex-wrap:wrap">
              <span class="pill cyan" dir="ltr">@${esc(prof?.username || '—')}</span>
              <span class="pill green">${esc(prof?.country_code || 'TN')}</span>
              <span class="pill amber">⚡ صانع معتمد</span>
            </p>
            <p style="color:var(--muted);font-size:.85rem;margin:.2rem 0">📅 عضو منذ ${fmtDate(prof?.created_at)}</p>
            <p style="color:var(--muted);font-size:.88rem;margin:.2rem 0">${esc(prof?.bio || 'لا نبذة بعد — عرّف بنفسك!')}</p>
          </div>
          <div class="prof-stats">
            <div><small>🌱 طاقة مُعاد تدويرها</small><div class="meter-7seg green" dir="ltr">[ ${Number(prof?.upcycled_energy_wh || 0)} Wh ]</div></div>
            <div><small>⚡ مشاريع منشورة</small><div class="meter-7seg amber" dir="ltr">[ ${pubCount || 0} ]</div></div>
          </div>
        </div>
        <div class="card">
          <h3 style="margin-top:0">✏️ تعديل الملف</h3>
          <div class="prof-form">
            <label>الاسم المعروض<input id="fName" value="${esc(prof?.display_name || '')}" /></label>
            <label>اسم المستخدم<input id="fUser" dir="ltr" value="${esc(prof?.username || '')}" /></label>
            <label>البلد<select id="fCountry">${['TN', 'FR', 'DZ', 'DE', 'US'].map((c) => `<option ${prof?.country_code === c ? 'selected' : ''}>${c}</option>`).join('')}</select></label>
            <label style="grid-column:1/-1">النبذة<textarea id="fBio" rows="2">${esc(prof?.bio || '')}</textarea></label>
          </div>
          <div style="display:flex;gap:.6rem;margin-top:.8rem;align-items:center">
            <button id="saveProf" class="btn btn-amber">💾 حفظ</button><span id="saveMsg" style="font-size:.85rem;color:var(--green)"></span>
          </div>
        </div>
        <div class="tabs" style="margin-top:1.2rem">
          <button class="tab active" data-tab="my">⚡ مشاريعي (${(mine || []).length})</button>
          <button class="tab" data-tab="fork">🍴 المنسوخة (${forked.length})</button>
        </div>
        <div id="tab-my" class="grid-3" style="margin-top:1rem">${(mine || []).map((p) => projectCard(p, true)).join('') || '<div class="card">لا مشاريع بعد — <a href="/workbench">ابدأ 🧪</a></div>'}</div>
        <div id="tab-fork" class="grid-3" style="margin-top:1rem" hidden>${forked.map((p) => projectCard(p, true)).join('') || '<div class="card">لم تنسخ أي تصميم بعد — <a href="/community">تصفح المجتمع 🌍</a></div>'}</div>`;

      bindCards(root);
      root.querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => {
        root.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        const my = b.getAttribute('data-tab') === 'my';
        document.getElementById('tab-my').hidden = !my;
        document.getElementById('tab-fork').hidden = my;
      }));
      document.getElementById('saveProf').addEventListener('click', async () => {
        const msg = document.getElementById('saveMsg');
        const { error } = await supabase.from('profiles').update({
          display_name: document.getElementById('fName').value.trim(),
          username: document.getElementById('fUser').value.trim().replace(/\s+/g, '_') || prof.username,
          bio: document.getElementById('fBio').value.trim(),
          country_code: document.getElementById('fCountry').value,
        }).eq('id', uid);
        msg.textContent = error ? '❌ ' + error.message : '✅ تم الحفظ!';
        if (!error) setTimeout(() => location.reload(), 800);
      });
      root.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', async () => {
        if (!confirm('حذف هذا المشروع نهائيًا؟')) return;
        await supabase.from('projects').delete().eq('id', b.getAttribute('data-del'));
        location.reload();
      }));
      if (location.hash === '#my') document.getElementById('tab-my')?.scrollIntoView();
    })();
  }
</script>

<style>
  .prof-hero { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; padding: 1.6rem; }
  .prof-avatar-wrap { margin-inline: auto; }
  .prof-avatar {
    width: 96px; height: 96px;
    border-radius: 9999px;
    object-fit: cover;
    border: 4px solid rgba(245, 158, 11, .3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, .45);
    margin-inline: auto;
    display: block;
    background: var(--surface2);
  }
  span.prof-avatar { display: grid; place-items: center; font-size: 2.4rem; }
  @media (min-width: 768px) { .prof-avatar { width: 112px; height: 112px; } }
  .prof-stats { display: flex; gap: .8rem; flex-wrap: wrap; justify-content: center; margin-inline: auto; text-align: center; }
  .prof-stats small { color: var(--muted); }
  .prof-form { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .7rem; }
  .prof-form label { display: grid; gap: .3rem; font-size: .85rem; font-weight: 700; }
  .prof-form input, .prof-form select, .prof-form textarea {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: .55rem .7rem; color: var(--text); font-family: inherit; font-size: .9rem;
  }
  .prof-card { display: grid; gap: .4rem; align-content: start; }
  .prof-card small { color: var(--muted); }
  .prof-card svg { border-radius: 10px; border: 1px solid var(--border); }
  .prof-actions { display: flex; gap: .45rem; flex-wrap: wrap; }
  .prof-mini { padding: .4rem .8rem; font-size: .8rem; }
  @media (max-width: 900px) { .prof-form { grid-template-columns: 1fr; } }
</style>
